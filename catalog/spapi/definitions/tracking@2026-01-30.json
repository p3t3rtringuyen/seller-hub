{
  "BoundedInterval": {
    "description": "A time interval defined by a start time and end time.",
    "properties": {
      "endTime": {
        "description": "The inclusive end of the interval, in UTC RFC 3339 date-time format.",
        "ref": "Instant"
      },
      "startTime": {
        "description": "The inclusive start of the interval, in UTC RFC 3339 date-time format.",
        "ref": "Instant"
      }
    },
    "required": [
      "endTime",
      "startTime"
    ],
    "type": "object"
  },
  "CarrierTracking": {
    "description": "The carrier information.",
    "properties": {
      "carrierCode": {
        "description": "The carrier code associated with the carrier tracking number.",
        "type": "string"
      },
      "trackingNumber": {
        "description": "The tracking number assigned by the carrier.",
        "type": "string"
      }
    },
    "required": [
      "trackingNumber"
    ],
    "type": "object"
  },
  "Error": {
    "description": "Error response returned when the request is unsuccessful.",
    "properties": {
      "code": {
        "description": "An error code that identifies the type of error that occurred.",
        "type": "string"
      },
      "details": {
        "description": "Additional details that can help the caller understand or fix the issue.",
        "type": "string"
      },
      "message": {
        "description": "A message that describes the error condition.",
        "type": "string"
      }
    },
    "required": [
      "code",
      "message"
    ],
    "type": "object"
  },
  "ErrorList": {
    "description": "A list of errors for an unsuccessful request.",
    "properties": {
      "errors": {
        "description": "An array of error details.",
        "ref": "Error",
        "type": "array"
      }
    },
    "required": [
      "errors"
    ],
    "type": "object"
  },
  "GetShipmentTrackingResponse": {
    "description": "Contains tracking details for a requested shipment.",
    "properties": {
      "trackingDetail": {
        "description": "Current and historical tracking information for a shipment.",
        "ref": "TrackingDetail"
      }
    },
    "required": [
      "trackingDetail"
    ],
    "type": "object"
  },
  "Instant": {
    "description": "A timestamp in UTC RFC 3339 date-time format.",
    "properties": {},
    "required": [],
    "type": "string"
  },
  "TrackingDetail": {
    "description": "Tracking information for the shipment identifier.",
    "properties": {
      "identifier": {
        "description": "The tracking identifier used to look up this shipment (for example, `id`, `acsin`, or `containerNumber`).",
        "ref": "TrackingIdentifier"
      },
      "latestMilestone": {
        "description": "The most recent milestone event for the shipment.",
        "ref": "TrackingMilestone"
      },
      "milestoneHistory": {
        "description": "A chronological list of all milestone events for the shipment, from most recent to oldest.",
        "ref": "TrackingMilestone",
        "type": "array"
      },
      "trackingEstimates": {
        "description": "A list of time-based estimated intervals for the shipment, such as estimated delivery date.",
        "ref": "TrackingEstimate",
        "type": "array"
      },
      "trackingUrl": {
        "description": "The URL to view the shipment's tracking information.",
        "type": "string"
      }
    },
    "required": [
      "identifier",
      "milestoneHistory"
    ],
    "type": "object"
  },
  "TrackingEstimate": {
    "description": "A time-based estimate for the shipment, such as estimated delivery date.",
    "properties": {
      "estimatedInterval": {
        "description": "The estimated time window for this event, represented as a start and end time in UTC RFC 3339 date-time format.",
        "ref": "BoundedInterval"
      },
      "lastUpdatedTime": {
        "description": "The timestamp when this estimate was last modified, in UTC RFC 3339 date-time format.",
        "ref": "Instant"
      },
      "type": {
        "description": "The type of estimate.",
        "type": "string"
      }
    },
    "required": [
      "estimatedInterval",
      "lastUpdatedTime",
      "type"
    ],
    "type": "object"
  },
  "TrackingIdentifier": {
    "description": "The identifier to track a shipment.",
    "properties": {
      "acsin": {
        "description": "The Air Cargo Shipment Identification Number.",
        "type": "string"
      },
      "aftn": {
        "description": "The Amazon Fulfillment Tracking Number.",
        "type": "string"
      },
      "carrierTracking": {
        "description": "The carrier-assigned tracking information.",
        "ref": "CarrierTracking"
      },
      "containerNumber": {
        "description": "The container number provided by the Logistics Service Provider.",
        "type": "string"
      },
      "houseBillOfLadingNumber": {
        "description": "The House Bill of Lading (HBL) number.",
        "type": "string"
      },
      "id": {
        "description": "A unique identifier generated by Amazon for the shipment tracking request.",
        "type": "string"
      },
      "proNumber": {
        "description": "The PRO number assigned by the freight carrier",
        "type": "string"
      }
    },
    "required": [],
    "type": "object"
  },
  "TrackingMilestone": {
    "description": "A single milestone event in a shipment's journey.",
    "properties": {
      "location": {
        "description": "The location where this milestone occurred, if available.",
        "ref": "TrackingMilestoneLocation"
      },
      "occurredAt": {
        "description": "The timestamp when this milestone occurred, in UTC RFC 3339 date-time format.",
        "ref": "Instant"
      },
      "status": {
        "description": "The milestone's status details.",
        "ref": "TrackingMilestoneStatus"
      }
    },
    "required": [
      "occurredAt",
      "status"
    ],
    "type": "object"
  },
  "TrackingMilestoneAddress": {
    "description": "The physical address of the location.",
    "properties": {
      "city": {
        "description": "The city where the milestone occurred.",
        "type": "string"
      },
      "countryCode": {
        "description": "The two-character country code in ISO 3166-1 alpha-2 format (for example, `US`).",
        "type": "string"
      },
      "region": {
        "description": "The state or region where the milestone occurred.",
        "type": "string"
      }
    },
    "required": [],
    "type": "object"
  },
  "TrackingMilestoneLocation": {
    "description": "The location where a tracking milestone occurred.",
    "properties": {
      "address": {
        "description": "The physical address where the milestone occurred.",
        "ref": "TrackingMilestoneAddress"
