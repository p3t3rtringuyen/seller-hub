  "QuerySellingAccountRequest": {
   "properties": {
    "maxResults": {
     "default": 100,
     "format": "int32",
     "maximum": 100,
     "minimum": 10,
     "type": "integer"
    },
    "nextToken": {
     "type": "string"
    },
    "sellingAccountLinkTokenFilter": {
     "$ref": "SellingAccountSellingAccountLinkTokenFilter"
    },
    "sellingProgramFilter": {
