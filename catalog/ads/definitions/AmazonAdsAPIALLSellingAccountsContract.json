   "properties": {
    "nextToken": {
     "type": "string"
    },
    "sellingAccounts": {
     "items": {
      "$ref": "SellingAccount"
     },
     "maxItems": 100,
     "minItems": 0,
     "type": "array"
    }
   },
   "type": "object"
  },
