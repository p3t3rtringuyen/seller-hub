# Copy to .env.local and fill in yourself. Never commit .env.local, never paste values in chat.
# The app's own variables (SH_*) are at the bottom. Dev-only placeholders are safe to keep for the local compose stack.

# --- SP-API (RESOURCES R5) — Seller Central > Apps and Services > Develop Apps
SPAPI_LWA_CLIENT_ID=
SPAPI_LWA_CLIENT_SECRET=
# Refresh token from self-authorizing the app for the test seller (private app)
SPAPI_REFRESH_TOKEN=
# na | eu | fe
SPAPI_REGION=na
# Comma-separated; US = ATVPDKIKX0DER
SPAPI_MARKETPLACE_IDS=ATVPDKIKX0DER

# --- Amazon Ads API (RESOURCES R6)
ADS_LWA_CLIENT_ID=
ADS_LWA_CLIENT_SECRET=
ADS_REFRESH_TOKEN=
# na | eu | fe
ADS_REGION=na

# =====================================================================================================
# seller-hub's own settings (P3-SCAFFOLD). Names are read by packages/config/src/env.ts.
# The values below are DEV-ONLY placeholders for the local compose stack; use real secrets elsewhere.
# =====================================================================================================

# development | test | production
NODE_ENV=development
# fatal | error | warn | info | debug | trace | silent
SH_LOG_LEVEL=info

# --- Dev stack (docker-compose.dev.yml) -------------------------------------------------------------
# Compose project name: use a different one per worktree/stack so containers and volumes do not collide.
COMPOSE_PROJECT_NAME=sellerhub
# Shifts every host port below by this amount: a MULTIPLE OF 100 from 0 to 900 (validated). A second stack: SH_PORT_OFFSET=100.
SH_PORT_OFFSET=0
# Explicit host ports win over the offset. Defaults (offset 0): pg 55432, redis 56379, minio 59000/59001,
# api 4100, web 3100 (none is a standard port).
# SH_PG_PORT=
# SH_REDIS_PORT=
# SH_MINIO_PORT=
# SH_MINIO_CONSOLE_PORT=
# SH_API_PORT=
# SH_WEB_PORT=

# --- PostgreSQL 16 (ADR-0009): sh_owner runs migrations; sh_app serves requests (no BYPASSRLS) ---------
SH_PG_HOST=127.0.0.1
SH_PG_DATABASE=seller_hub
SH_PG_OWNER_PASSWORD=sh_owner_dev_only
SH_PG_APP_PASSWORD=sh_app_dev_only
# Full URLs override the derived ones (cloud / external database).
SH_DATABASE_URL=
SH_DATABASE_OWNER_URL=

# --- Redis 7 (BullMQ, limiter) ----------------------------------------------------------------------
SH_REDIS_URL=

# --- Object storage, S3-compatible (raw landing, exports; ADR-0009) ------------------------------------
SH_S3_ENDPOINT=
SH_S3_REGION=us-east-1
SH_S3_BUCKET=seller-hub
SH_S3_ACCESS_KEY=sh_minio_dev_only
SH_S3_SECRET_KEY=sh_minio_dev_only_secret
# Raw payloads are deleted after this many days.
SH_RAW_RETENTION_DAYS=35
# Job-run history kept this many days (D64 a).
SH_JOB_RUN_RETENTION_DAYS=90

# --- HTTP ------------------------------------------------------------------------------------------
SH_API_HOST=127.0.0.1
# Where apps/web reaches apps/api (server side only). Empty = derived from the API port.
SH_API_URL=
# Public URL of the web app: cookies, the CSRF Origin check, invitation links and the Ads redirect URI. Empty = derived from the
# web port (http://127.0.0.1:<port>). Open the app at THIS address in dev: localhost and 127.0.0.1 are different origins
# (in plain-http dev the origin you are served from is accepted too, but links and cookies follow this value).
# PRODUCTION requires https:// here (the API refuses to start otherwise).
SH_WEB_PUBLIC_URL=

# --- Secrets added by later tasks -------------------------------------------------------------------
# Vault master key (ADR-0005), 32 bytes base64. REQUIRED: the API refuses to start without one. The value below is a
# DEV-ONLY placeholder (loadConfig refuses it with NODE_ENV=production); generate your own:
#   node -e "console.log(require('node:crypto').randomBytes(32).toString('base64'))"
# Back it up: losing it makes every stored Amazon connection unrecoverable (reconnect is the recovery).
SH_MASTER_KEY=ZGV2LW9ubHktbWFzdGVyLWtleS1zZWxsZXItaHViISE=
# Key ring for rotation: comma list of kid:base64 (takes precedence over SH_MASTER_KEY); SH_MASTER_KEY_ACTIVE names the
# kid that encrypts new credentials (default: the first).
# SH_MASTER_KEYS=
# SH_MASTER_KEY_ACTIVE=

# --- Behind a reverse proxy / Cloudflare Tunnel (D66 staging) ---------------------------------------------
# 1 = trust X-Forwarded-For / CF-Connecting-IP for the client IP in sessions and audit rows. Leave 0 when the web
# app is reachable directly. Cookies are Secure (and __Host- prefixed) automatically when SH_WEB_PUBLIC_URL is https.
SH_TRUST_PROXY=0
# Shared secret (>= 32 chars) by which the web BFF vouches for the client IP / user-agent it forwards to the API. REQUIRED in
# production; set the same value for the web and the api process. Unset (dev) = the API believes those headers.
# SH_BFF_SECRET=

# --- Amazon mode (D30 is OPEN) --------------------------------------------------------------------------
# replay (default when unset) = every Amazon call is answered by recorded fixtures, nothing reaches a live account;
# sandbox = SP-API sandbox host; production = live. Do not set production before D30 is decided.
# SH_AMAZON_MODE=replay

# --- Test switches (CI sets these) -------------------------------------------------------------------
# 1 = integration tests must have a database (fail instead of skip).
# SH_REQUIRE_DB=1
# Optional: another env file to load instead of .env.local (for example .env.example in CI).
# SH_ENV_FILE=.env.example
