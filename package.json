{
  "name": "seller-hub",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "packageManager": "pnpm@10.12.1",
  "engines": {
    "node": ">=24"
  },
  "scripts": {
    "gen": "tsx tools/registry/src/cli.ts && pnpm --filter @seller-hub/contracts run gen",
    "lint": "turbo run lint --concurrency=4 && eslint tools/registry tools/contracts scripts/stack.ts scripts/test-integration.ts e2e .storybook playwright.config.ts eslint.config.mjs && prettier --check .",
    "typecheck": "turbo run typecheck && tsc --noEmit",
    "test": "turbo run test && vitest run --root tools",
    "test:integration": "tsx scripts/test-integration.ts",
    "build": "turbo run build",
    "gate": "pnpm gen && pnpm lint && pnpm typecheck && pnpm test && pnpm build",
    "format": "prettier --write .",
    "dev": "turbo run dev --parallel",
    "stack": "tsx scripts/stack.ts",
    "stack:up": "tsx scripts/stack.ts up",
    "stack:down": "tsx scripts/stack.ts down",
    "stack:ps": "tsx scripts/stack.ts ps",
    "db:migrate": "pnpm --filter @seller-hub/db run migrate",
    "db:reset": "pnpm --filter @seller-hub/db run reset",
    "db:seed": "pnpm --filter @seller-hub/db run seed",
    "db:codegen": "pnpm --filter @seller-hub/db run codegen",
    "contracts:lint": "pnpm --filter @seller-hub/contracts run lint",
    "new:module": "tsx tools/registry/src/new-module.ts",
    "e2e": "playwright test",
    "storybook": "storybook dev -p 6006 -c .storybook",
    "build-storybook": "storybook build -c .storybook"
  },
  "devDependencies": {
    "@playwright/test": "catalog:",
    "@redocly/cli": "catalog:",
    "@redocly/openapi-core": "catalog:",
    "@seller-hub/config": "workspace:*",
    "@storybook/react-vite": "catalog:",
    "@types/node": "catalog:",
    "@vitejs/plugin-react": "catalog:",
    "eslint": "catalog:",
    "fast-glob": "catalog:",
    "prettier": "catalog:",
    "react": "catalog:",
    "react-dom": "catalog:",
    "storybook": "catalog:",
    "tsx": "catalog:",
    "turbo": "catalog:",
    "typescript": "catalog:",
    "vite": "catalog:",
    "vitest": "catalog:",
    "yaml": "catalog:"
  }
}
